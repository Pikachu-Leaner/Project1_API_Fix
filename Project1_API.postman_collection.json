{
  "info": {
    "name": "Project1 API Collection",
    "_postman_id": "project1-api-v2",
    "description": "Full API collection for Project1_API_Fix including Auth (access+refresh tokens), Products, Categories, Cart, Orders, Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost/Project1_API_Fix/api", "type": "string" },
    { "key": "access_token",  "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "user_email",    "value": "testuser@example.com", "type": "string" },
    { "key": "user_password", "value": "Test1234", "type": "string" },
    { "key": "debug_otp",     "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test User\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.debug_otp) {",
              "  pm.collectionVariables.set('debug_otp', r.data.debug_otp);",
              "  console.log('OTP:', r.data.debug_otp);",
              "}"
            ]}
          }]
        },
        {
          "name": "Verify OTP (auto-login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"otp\": \"{{debug_otp}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data) {",
              "  pm.collectionVariables.set('access_token',  r.data.access_token);",
              "  pm.collectionVariables.set('refresh_token', r.data.refresh_token);",
              "}"
            ]}
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"remember_me\": false\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data) {",
              "  pm.collectionVariables.set('access_token',  r.data.access_token);",
              "  pm.collectionVariables.set('refresh_token', r.data.refresh_token);",
              "}"
            ]}
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data) {",
              "  pm.collectionVariables.set('access_token',  r.data.access_token);",
              "  pm.collectionVariables.set('refresh_token', r.data.refresh_token);",
              "}"
            ]}
          }]
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{user_email}}\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.debug_otp) pm.collectionVariables.set('debug_otp', r.data.debug_otp);"
            ]}
          }]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"otp\": \"{{debug_otp}}\",\n  \"new_password\": \"NewPass1\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?sort=noi_bat&page=1",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "sort",     "value": "noi_bat" },
                { "key": "category", "value": "",       "disabled": true },
                { "key": "search",   "value": "",       "disabled": true },
                { "key": "sort",     "value": "gia_tang","disabled": true, "description": "Price Low→High" },
                { "key": "sort",     "value": "gia_giam","disabled": true, "description": "Price High→Low" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/1"
          }
        },
        {
          "name": "Search / Suggest",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/suggest?q=iphone"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": { "method": "GET", "url": "{{base_url}}/categories" }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/cart"
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/cart/items",
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1\n}" }
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/cart/items/1",
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"increase\"\n}" }
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/cart/items/1"
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/cart"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/orders"
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Test User\",\n  \"phone\": \"0901234567\",\n  \"address\": \"123 Test Street\",\n  \"payment_method\": \"COD\",\n  \"notes\": \"\"\n}"
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/orders/1"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/dashboard"
          }
        },
        {
          "name": "Revenue by Day (last 30d)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/revenue/day"
          }
        },
        {
          "name": "Revenue by Month (last 12mo)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/revenue/month"
          }
        },
        {
          "name": "Revenue by Year",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/revenue/year"
          }
        },
        {
          "name": "Orders by Day (last 30d)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/orders/day"
          }
        },
        {
          "name": "Top Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/products/top"
          }
        },
        {
          "name": "Get All Users (with status)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/users"
          }
        },
        {
          "name": "Toggle User Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/users/2/status"
          }
        },
        {
          "name": "Get All Products (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/products"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"brand\": \"Apple\",\n  \"price\": 29990000,\n  \"old_price\": 32990000,\n  \"category_id\": 1,\n  \"image_url\": \"public/images/Phone-card-image-1.jpg\",\n  \"details\": \"Latest Apple flagship.\",\n  \"sales_count\": 0,\n  \"is_featured\": true\n}"
            }
          }
        },
        {
          "name": "Update Product (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/products/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro Max\",\n  \"brand\": \"Apple\",\n  \"price\": 34990000,\n  \"old_price\": null,\n  \"category_id\": 1,\n  \"image_url\": \"public/images/Phone-card-image-1.jpg\",\n  \"details\": \"Updated description.\",\n  \"sales_count\": 5,\n  \"is_featured\": true\n}"
            }
          }
        },
        {
          "name": "Patch Product",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/products/1",
            "body": { "mode": "raw", "raw": "{\n  \"price\": 27990000\n}" }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/products/1"
          }
        },
        {
          "name": "Get All Categories (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/categories"
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Smartphones\"\n}" }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/categories/1",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mobile Phones\"\n}" }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/categories/1"
          }
        },
        {
          "name": "Get All Orders (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/orders"
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/orders/1/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Delivering\"\n}" }
          }
        },
        {
          "name": "Delete Order (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/orders/1"
          }
        }
      ]
    }
  ]
}
