# Copy this file to .env for Laragon/local testing.
# For Render, add these as Environment Variables instead of uploading .env.

APP_DEBUG=true
JWT_SECRET=change-this-to-a-long-random-secret

# Local Laragon MySQL example:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=electronic_store
# DB_USER=root
# DB_PASS=

# Aiven MySQL example. Use the values from Aiven Service Overview.
DB_HOST= yourhost
DB_PORT= yourport
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS= yourpass

# Aiven SSL CA certificate file for local Laragon.
# Download ca.pem from Aiven and put it in your project root.
DB_SSL_CA=C:/laragon/www/Project1_API/ca.pem
DB_SSL_VERIFY=true

# Render alternative: paste the CA content into Render as DB_SSL_CA_CONTENT.
# DB_SSL_CA_CONTENT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
